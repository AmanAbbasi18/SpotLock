# ==============================================================================
# SeatSure - Comprehensive Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Sensitive Credentials (NEVER commit secrets!)
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.jks
*.p12
*.pfx
secrets/

# Keep the example template tracked
!.env.example

# ------------------------------------------------------------------------------
# 2. Local Tools & Temporary Scratch Folders
# ------------------------------------------------------------------------------
.tools/
scratch/
temp/
tmp/

# ------------------------------------------------------------------------------
# 3. Java & Maven Build Outputs
# ------------------------------------------------------------------------------
target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
dependency-reduced-pom.xml
build/
**/build/
.gradle/
**/out/

# Keep maven wrapper scripts and properties
!.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties

# ------------------------------------------------------------------------------
# 4. Node.js & Frontend Artifacts
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
coverage/
**/coverage/
.turbo/
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 5. Database & Local Storage Files
# ------------------------------------------------------------------------------
*.mv.db
*.trace.db
*.db
*.sqlite
*.sqlite3
data/
mysql-data/
redis-data/
kafka-data/

# ------------------------------------------------------------------------------
# 6. Application Logs
# ------------------------------------------------------------------------------
logs/
**/logs/
*.log

# ------------------------------------------------------------------------------
# 7. IDE & Editor Metadata
# ------------------------------------------------------------------------------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.built-jar-dir/

# Vim / Sublime
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# ------------------------------------------------------------------------------
# 8. Operating System Metadata
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
