# ==========================================================
# SeatSure Local & Docker Environment Variables
# ==========================================================

# Database Settings
MYSQL_ROOT_PASSWORD=root_secret
MYSQL_DATABASE=seatsuredb
MYSQL_USER=seatsure
MYSQL_PASSWORD=seatsure_secret
MYSQL_PORT=3306

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka Settings
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# JWT Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Administrator Bootstrap Credentials
SEATSURE_ADMIN_EMAIL=admin@seatsure.com
SEATSURE_ADMIN_PASSWORD=Admin@12345
SEATSURE_ADMIN_NAME=SeatSure Administrator

# Booking & Reservation Policy
HOLD_DURATION_SECONDS=300
CANCELLATION_WINDOW_HOURS=2

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
